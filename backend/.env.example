# SatyaCheck Backend Environment Configuration
PROJECT_NAME="SatyaCheck — AICTE Trust Layer"

# Security Secrets (Generate using: python -c "import secrets; from cryptography.fernet import Fernet; print('SECRET_KEY=' + secrets.token_urlsafe(32)); print('FERNET_KEY=' + Fernet.generate_key().decode())")
SECRET_KEY="generate-a-secure-random-secret-key"
FERNET_KEY="generate-a-valid-fernet-key-base64-32-bytes"
FERNET_OLD_KEYS=""

# Database
DATABASE_URL="sqlite:///./satyacheck.db"

# Gemini API & AI Verification Agent Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
USE_OFFLINE_DETECTORS=false
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_SECONDS=60

# Data Retention Policy
DATA_RETENTION_DAYS=365
MASK_SENSITIVE_DATA=true
